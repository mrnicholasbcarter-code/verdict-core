[3.545985, "o", "\u001b[1;38;2;167;139;250mRUNS        \u001b[0m\u001b[38;2;34;184;235m  \u001b[0m\u001b[38;2;161;161;170m                                                      \u001b[0m\r\n\u001b[38;2;34;184;235m/orchestrate\u001b[0m\u001b[38;2;34;184;235m  \u001b[0m\u001b[38;2;161;161;170mgoal -> DAG -> parallel workers -> review -> receipt  \u001b[0m\r\n\u001b[38;2;34;184;235m/supervise  \u001b[0m\u001b[38;2;34;184;235m  \u001b[0m\u001b[38;2;161;161;170mrun orchestrate under a stall/quota-aware supervisor  \u001b[0m\r\n\u001b[38;2;34;184;235m/watch      \u001b[0m\u001b[38;2;34;184;235m  \u001b[0m\u001b[38;2;161;161;170mlive view of a run (or --once for a snapshot)         \u001b[0m\r\n\u001b[1;38;2;167;139;250mTRACES      \u001b[0m\u001b[38;2;34;184;235m  \u001b[0m\u001b[38;2;161;161;170m                                                      \u001b[0m\r\n\u001b[38;2;34;184;235m/trace      \u001b[0m\u001b[38;2;34;184;235m  \u001b[0m\u001b[38;2;161;161;170mhuman-readable trace of an orchestration run          \u001b[0m\r\n\u001b[38;2;34;184;235m/demo       \u001b[0m\u001b[38;2;34;184;235m  \u001b[0m\u001b[38;2;161;161;170mcredential-free deterministic demo (offline scenario) \u001b[0m\r\n\u001b[38;2;34;184;235m/run-receipt\u001b[0m\u001b[38;2;34;184;235m  \u001b[0m\u001b[38;2;161;161;170mverify an orchestration receipt (proof surface)       \u001b[0m\r\n\u001b[38;2;34;184;235m/receipt    \u001b[0m\u001b[38;2;34;184;235m  \u001b[0m\u001b[38;2;161;161;170minspect routing receipts (RoutingReceiptV1)           \u001b[0m\r\n\u001b[38;2;34;184;235m/replay     \u001b[0m\u001b[38;2;34;184;235m  \u001b[0m\u001b[38;2;161;161;170mreplay a routing decision session                     \u001b[0m\r\n\u001b[1;38;2;167;139;250mHEALTH      \u001b[0m\u001b[38;2;34;184;235m  \u001b[0m\u001b[38;2;161;161;170m                                                      \u001b[0m\r\n\u001b[38;2;34;184;235m/eligibility\u001b[0m\u001b[38;2;34;184;235m  \u001b[0m\u001b[38;2;161;161;170mDISCOVERED > ENTITLED > HEALTHY > AVAILABLE > ELIGIBLE\u001b[0m\r\n\u001b[38;2;34;184;235m/probe      \u001b[0m\u001b[38;2;34;184;235m  \u001b[0m\u001b[38;2;161;161;170mone-token liveness probes                             \u001b[0m\r\n\u001b[38;2;34;184;235m/detect     \u001b[0m\u001b[38;2;34;184;235m  \u001b[0m\u001b[38;2;161;161;170mdetect reachable providers                            \u001b[0m\r\n\u001b[1;38;2;167;139;250mMODELS      \u001b[0m\u001b[38;2;34;184;235m  \u001b[0m\u001b[38;2;161;161;170m                                                      \u001b[0m\r\n\u001b[38;2;34;184;235m/models     \u001b[0m\u001b[38;2;34;184;235m  \u001b[0m\u001b[38;2;161;161;170mlocal model catalog view                              \u001b[0m\r\n\u001b[38;2;34;184;235m/catalog    \u001b[0m\u001b[38;2;34;184;235m  \u001b[0m\u001b[38;2;161;161;170mOmniRoute catalog dump                                \u001b[0m\r\n\u001b[1;38;2;167;139;250mROUTING     \u001b[0m\u001b[38;2;34;184;235m  \u001b[0m\u001b[38;2;161;161;170m                                                      \u001b[0m\r\n\u001b[38;2;34;184;235m/route      \u001b[0m\u001b[38;2;34;184;235m  \u001b[0m\u001b[38;2;161;161;170mroute one task through the gate                       \u001b[0m\r\n\u001b[38;2;34;184;235m/routing    \u001b[0m\u001b[38;2;34;184;235m  \u001b[0m\u001b[38;2;161;161;170mrecorded routing explorer for a run                   \u001b[0m\r\n\u001b[38;2;34;184;235m/compare    \u001b[0m\u001b[38;2;34;184;235m  \u001b[0m\u001b[38;2;161;161;170mcompare dual-route results                            \u001b[0m\r\n\u001b[1;38;2;167;139;250mCONTEXT     \u001b[0m\u001b[38;2;34;184;235m  \u001b[0m\u001b[38;2;161;161;170m                                                      \u001b[0m\r\n\u001b[38;2;34;184;235m/context    \u001b[0m\u001b[38;2;34;184;235m  \u001b[0m\u001b[38;2;161;161;170mrecorded context budget and provenance                \u001b[0m\r\n\u001b[1;38;2;167;139;250mOVERVIEW    \u001b[0m\u001b[38;2;34;184;235m  \u001b