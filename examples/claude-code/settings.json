{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "OPENAI_BASE_URL": "http://127.0.0.1:8000/v1"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "verdict",
            "args": ["hook", "claude-gate"],
            "timeout": 70
          }
        ]
      }
    ]
  }
}
