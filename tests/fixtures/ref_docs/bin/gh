#!/usr/bin/env python3
"""Fake `gh` for the ref-docs integration test: serves git trees and blobs from a fixture dir."""

import base64
import json
import os
import re
import sys
from pathlib import Path

REPO = "acme/widget"


def main(argv: list[str]) -> int:
    root = Path(os.environ["REF_DOCS_FIXTURE_DIR"])
    if len(argv) == 2 and argv[0] == "api":
        tree = re.fullmatch(rf"repos/{REPO}/git/trees/([^?/]+)\?recursive=1", argv[1])
        blob = re.fullmatch(rf"repos/{REPO}/git/blobs/([0-9a-f]{{40}})", argv[1])
        if tree and (root / "trees" / f"{tree.group(1)}.json").is_file():
            sys.stdout.write((root / "trees" / f"{tree.group(1)}.json").read_text("utf-8"))
            return 0
        if blob and (root / "blobs" / blob.group(1)).is_file():
            raw = (root / "blobs" / blob.group(1)).read_bytes()
            content = base64.encodebytes(raw).decode()
            json.dump({"sha": blob.group(1), "encoding": "base64", "content": content}, sys.stdout)
            return 0
    sys.stderr.write(f"fake gh: unexpected call: gh {' '.join(argv)}\n")
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
