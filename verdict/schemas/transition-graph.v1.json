{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verdict.dev/schemas/transition-graph.v1.json",
  "title": "Verdict Transition Graph v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["policy_version", "request_id", "byte_state", "nodes", "edges", "compilation", "compiled_at"],
  "properties": {
    "policy_version": {"type": "string", "minLength": 1}, "request_id": {"type": "string", "minLength": 1}, "byte_state": {"enum": ["pre_bytes", "bytes_emitted"]}, "nodes": {"type": "array", "items": {"type": "string", "minLength": 1}}, "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}}, "compilation": {"type": "object"}, "compiled_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {"edge": {"type": "object", "additionalProperties": false, "required": ["source", "target", "kind", "legal", "reasons", "route_key", "evidence_ids"], "properties": {"source": {"type": "string", "minLength": 1}, "target": {"type": "string", "minLength": 1}, "kind": {"enum": ["initial", "retry", "fallback", "checkpoint_resume", "terminal"]}, "legal": {"type": "boolean"}, "reasons": {"type": "array", "items": {"type": "string", "minLength": 1}}, "route_key": {"type": ["string", "null"]}, "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}}}}
}
