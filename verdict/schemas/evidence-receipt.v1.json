{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verdict.dev/schemas/evidence-receipt.v1.json",
  "title": "Verdict Evidence Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "kind",
    "scope",
    "occurred_at",
    "evidence",
    "payload",
    "parent_receipt_ids",
    "extensions"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "receipt_id": { "$ref": "#/$defs/non_empty_string" },
    "kind": {
      "enum": ["decision", "context", "execution", "verification", "outcome"]
    },
    "scope": { "$ref": "#/$defs/non_empty_string" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "requested_alias": { "$ref": "#/$defs/non_empty_string" },
    "selected_route": { "$ref": "#/$defs/route_identity" },
    "actual_route": { "$ref": "#/$defs/route_identity" },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidence_item" }
    },
    "payload": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "attempt",
          "correlation_id",
          "cost",
          "failure_class",
          "fallback_count",
          "latency_ms",
          "policy_version",
          "quality_outcome",
          "request_id",
          "route_key",
          "status_code",
          "task_fingerprint",
          "token_counts",
          "transport_outcome",
          "verification_status"
        ]
      }
    },
    "parent_receipt_ids": {
      "type": "array",
      "items": { "$ref": "#/$defs/non_empty_string" }
    },
    "extensions": { "type": "object" }
  },
  "$defs": {
    "route_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gateway", "provider", "connection", "endpoint", "protocol", "model_id"],
      "properties": {
        "gateway": { "$ref": "#/$defs/non_empty_string" },
        "provider": { "$ref": "#/$defs/non_empty_string" },
        "connection": { "$ref": "#/$defs/non_empty_string" },
        "endpoint": { "$ref": "#/$defs/non_empty_string" },
        "protocol": { "$ref": "#/$defs/non_empty_string" },
        "model_id": { "$ref": "#/$defs/non_empty_string" },
        "model_revision": { "$ref": "#/$defs/non_empty_string" },
        "account_class": { "$ref": "#/$defs/non_empty_string" },
        "endpoint_class": { "$ref": "#/$defs/non_empty_string" },
        "transformation_chain": { "$ref": "#/$defs/string_array" },
        "fallback_chain": { "$ref": "#/$defs/string_array" }
      }
    },
    "evidence_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "source",
        "method",
        "adapter_version",
        "observed_at",
        "expires_at",
        "scope",
        "confidence",
        "evidence_digest",
        "limitations"
      ],
      "properties": {
        "authority": {
          "enum": ["claimed", "observed", "verified", "inferred"]
        },
        "source": { "$ref": "#/$defs/non_empty_string" },
        "method": { "$ref": "#/$defs/non_empty_string" },
        "adapter_version": { "$ref": "#/$defs/non_empty_string" },
        "observed_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" },
        "scope": { "$ref": "#/$defs/non_empty_string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "limitations": {
          "type": "array",
          "items": { "$ref": "#/$defs/non_empty_string" }
        },
        "sample_count": { "type": "integer", "minimum": 1 }
      }
    },
    "non_empty_string": { "type": "string", "minLength": 1 },
    "string_array": {
      "type": "array",
      "items": { "$ref": "#/$defs/non_empty_string" }
    }
  }
}
