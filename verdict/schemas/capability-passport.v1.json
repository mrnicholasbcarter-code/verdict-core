{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verdict.dev/schemas/capability-passport.v1.json",
  "title": "Verdict Capability Passport v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "route_identity",
    "qualified_at",
    "expires_at",
    "claimed",
    "observed",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "route_identity": {
      "$ref": "#/$defs/route_identity"
    },
    "qualified_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "claimed": {
      "$ref": "#/$defs/capability_map"
    },
    "observed": {
      "$ref": "#/$defs/capability_map"
    },
    "limitations": {
      "$ref": "#/$defs/limitations"
    }
  },
  "$defs": {
    "route_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gateway",
        "provider",
        "connection",
        "endpoint",
        "protocol",
        "model_id"
      ],
      "properties": {
        "gateway": {
          "$ref": "#/$defs/non_empty_string"
        },
        "provider": {
          "$ref": "#/$defs/non_empty_string"
        },
        "connection": {
          "$ref": "#/$defs/non_empty_string"
        },
        "endpoint": {
          "$ref": "#/$defs/non_empty_string"
        },
        "protocol": {
          "$ref": "#/$defs/non_empty_string"
        },
        "model_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "model_revision": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "capability_map": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_.-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/evidence"
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "source",
        "observed_at",
        "expires_at",
        "confidence",
        "evidence_digest",
        "limitations"
      ],
      "properties": {
        "status": {
          "enum": [
            "supported",
            "unsupported",
            "unknown"
          ]
        },
        "source": {
          "$ref": "#/$defs/non_empty_string"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "limitations": {
          "$ref": "#/$defs/limitations"
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    }
  }
}
