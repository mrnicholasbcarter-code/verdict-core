# WARNING: Do not commit this file with real API keys.
# Copy to `.env` and fill in real values; `.env` is gitignored.

# --- Routing ---

# string, default: unset. Base URL of the local gateway (OmniRoute/9router)
# that verdict routes requests through. Run `verdict detect` to find one.
OMNIROUTE_BASE_URL=""

# string, default: unset. API key/token for the configured OmniRoute gateway.
OMNIROUTE_API_KEY=""

# string, default: unset. Management-plane token used for OmniRoute
# provider-node administration endpoints (e.g. /api/provider-nodes).
OMNIROUTE_MANAGEMENT_TOKEN=""

# bool ("1"/"true"), default: false. Allow OMNIROUTE_BASE_URL to point at a
# private/internal host (disabled by default as an SSRF guard).
OMNIROUTE_ALLOW_PRIVATE_HOSTS=""

# string, default: unset. Usage-reporting API key id sent to OmniRoute.
OMNIROUTE_USAGE_API_KEY_ID=""

# string, default: unset. Primary/preferred upstream identifier for llmgate.
LLMGATE_PRIMARY=""

# string, default: unset. Base URL of the upstream LLM provider llmgate
# forwards requests to.
LLMGATE_UPSTREAM_BASE_URL=""

# string, default: unset. API key for the llmgate upstream provider.
LLMGATE_UPSTREAM_API_KEY=""

# int (ms), default: unset (uses internal default). Timeout for upstream
# llmgate requests.
LLMGATE_UPSTREAM_TIMEOUT_MS=""

# bool, default: false. Allow llmgate upstream URLs to point at private hosts.
LLMGATE_UPSTREAM_ALLOW_PRIVATE_HOSTS=""

# comma-separated string, default: unset (all allowed). Restrict which model
# ids llmgate will route to.
LLMGATE_MODEL_ALLOWLIST=""

# comma-separated string, default: unset (none denied). Model ids llmgate
# refuses to route to.
LLMGATE_MODEL_DENYLIST=""

# comma-separated string, default: unset. Model ids considered "frontier"
# for escalation policy purposes.
LLMGATE_FRONTIER_ALLOWLIST=""

# int (seconds), default: unset (internal default). TTL for cached model
# passport/capability data.
LLMGATE_MODEL_PASSPORT_TTL=""

# int (seconds), default: unset (internal default). TTL for cached provider
# discovery results.
LLMGATE_DISCOVERY_TTL_SECONDS=""

# string, default: unset. Which intelligence/capability profile to apply
# when scoring candidate models.
LLMGATE_INTELLIGENCE_PROFILE=""

# int (ms), default: unset (internal default). Timeout for intelligence
# profile lookups.
LLMGATE_INTELLIGENCE_TIMEOUT_MS=""

# string ("development" | "production"), default: "production". Controls
# availability/health-check strictness; `verdict serve --dev` sets this to
# "development".
LLMGATE_AVAILABILITY_PROFILE=""

# string, default: unset. Base URL used for live upstream availability probes.
LLMGATE_PROBE_BASE_URL=""

# string, default: unset. API key used for live upstream availability probes.
LLMGATE_PROBE_API_KEY=""

# bool, default: false. Explicit consent flag required before live probes
# are allowed to run against a real upstream.
LLMGATE_PROBE_CONSENTED=""

# bool, default: false. Enable live (network) availability probes at all.
LLMGATE_ALLOW_LIVE_PROBES=""

# bool, default: false. Allow unauthenticated access to llmgate endpoints.
LLMGATE_ALLOW_ANONYMOUS=""

# string, default: unset. Bearer token required to authenticate to llmgate.
LLMGATE_AUTH_TOKEN=""

# --- API Server (verdict serve) ---

# string, default: "127.0.0.1". Host/interface `verdict serve` binds to.
LLMGATE_HOST=""

# string, default: unset. Path to a Unix domain socket to serve on instead
# of (or in addition to) TCP.
LLMGATE_UNIX_SOCKET=""

# int (bytes), default: unset (internal default). Maximum accepted request
# body size for the API server.
LLMGATE_MAX_REQUEST_BYTES=""

# string (path), default: unset (stdout). File path to write server logs to.
LLMGATE_LOG_PATH=""

# --- Memory ---

# string (path), default: platform-specific under XDG data dir. SQLite path
# for verdict's routing/memory database.
VERDICT_MEMORY_DB=""

# string (path), default: unset. Path to the shared MemoryPlane store used
# for cross-session context.
VERDICT_MEMORY_PLANE_PATH=""

# string (path), default: unset (internal default). SQLite path for the
# evidence/outcome-tracking store.
VERDICT_EVIDENCE_DB=""

# int, default: unset (internal default). Maximum number of evidence
# entries retained before pruning.
VERDICT_EVIDENCE_MAX_ENTRIES=""

# string (path), default: unset (internal default). SQLite path for
# verification/model receipts.
VERDICT_RECEIPTS_DB=""

# string (path), default: unset. Root directory of a local Ruflo checkout,
# used for advisory learning-signal ingestion.
VERDICT_RUFLO_ROOT=""

# string (git ref), default: unset. Git ref/branch to read Ruflo data from.
VERDICT_RUFLO_REF=""

# string (path), default: unset. Root directory of a local RuVector
# checkout, used for advisory similarity-signal ingestion.
VERDICT_RUVECTOR_ROOT=""

# string (git ref), default: unset. Git ref/branch to read RuVector data from.
VERDICT_RUVECTOR_REF=""

# string, default: unset. Command used to invoke the Ruflo CLI when present.
LLMGATE_RUFLO_COMMAND=""

# string, default: unset. Command used to invoke the RuVector CLI when present.
LLMGATE_RUVECTOR_COMMAND=""

# --- Toolchain / Runtime ---

# string (path), default: "~/.config". Base config directory; verdict reads
# config from "$XDG_CONFIG_HOME/verdict/verdict.yaml".
XDG_CONFIG_HOME=""

# string (path), default: unset (internal default). Directory for verdict's
# runtime state (locks, sockets, scratch files).
VERDICT_RUNTIME_STATE_DIR=""

# string (path or URL), default: unset. Location of routing guidance
# documents fetched at runtime.
VERDICT_GUIDANCE_PATH=""

# string (path), default: unset. Local filesystem override for routing
# guidance documents (skips remote fetch).
VERDICT_GUIDANCE_LOCAL_PATH=""

# string (path), default: platform-specific. Codex CLI home directory, used
# when detecting the Codex toolchain.
CODEX_HOME=""

# --- Providers (Cloud — optional) ---

# string, default: unset. OpenAI API key (must start with "sk-").
OPENAI_API_KEY=""

# string (URL), default: "https://api.openai.com/v1". OpenAI API base URL
# override (e.g. for a proxy).
OPENAI_API_BASE=""

# string (URL), default: "https://api.openai.com/v1". Alternate OpenAI base
# URL override recognized by some SDKs.
OPENAI_BASE_URL=""

# string, default: unset. OpenRouter API key for the cloud OpenRouter
# aggregator.
OPENROUTER_API_KEY=""

# string, default: unset. Google Gemini API key.
GEMINI_API_KEY=""

# string, default: unset. Hermes provider API key.
HERMES_API_KEY=""

# string, default: unset. Pi provider API key.
PI_API_KEY=""

# string, default: unset. xAI management-plane API key.
XAI_MANAGEMENT_API_KEY=""

# string, default: unset. xAI team id associated with the management API key.
XAI_TEAM_ID=""
