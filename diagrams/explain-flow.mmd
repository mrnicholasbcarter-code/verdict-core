%% explain-flow.mmd -- GET /v1/route/explain
%% Source (verified against code at this commit):
%%   verdict/api.py (route_explain, _evidence_scope, _router_dev_mode)
%%   verdict/availability_cache.py (CacheKey, _Entry, AvailabilityCache.get/.explain, explain_freshness, _confidence_for)
%%   verdict/eligibility.py (EligibilityGate.evaluate, EligibilityRecord.to_dict)
%%   verdict/evidence.py (AmbiguousEvidenceSelectorError)
flowchart TD
    GET["GET /v1/route/explain -- route_explain(model_id, evidence_id, request_id, correlation_id)"]
    GET --> MULTI{"more than one selector supplied?"}
    MULTI -- yes --> E400["_proxy_error(400, 'provide exactly one explain query selector')"]
    MULTI -- no --> EVSEL{"evidence_id or request_id or correlation_id given?"}

    EVSEL -- yes --> EVFIND["evidence_store_instance.find(scope=_evidence_scope(request))"]
    EVFIND --> EVAMB["AmbiguousEvidenceSelectorError -> _proxy_error(409, 'evidence selector is ambiguous; use evidence_id')"]
    EVFIND --> EVNOSTORE["evidence_store_instance is None -> _proxy_error(503, 'execution evidence is unavailable')"]
    EVFIND --> EVNONE["not found -> _proxy_error(404, 'routing evidence not found')"]
    EVFIND --> EVOK["JSONResponse(evidence.to_dict()) -- independent of live availability"]

    EVSEL -- no --> CACHECFG{"availability_cache_instance is None?"}
    CACHECFG -- yes --> C503["_proxy_error(503, 'availability cache not configured (set OMNIROUTE_BASE_URL to enable)')"]
    CACHECFG -- no --> SCOPE{"model_id empty or None?"}

    SCOPE -- "empty -> scope view" --> SCOPEDOC["base dict: kind=availability_explain, policy_version, cached_models=cache.keys(), cache_state=configured"]
    SCOPEDOC --> SCOPEGATE["if eligibility_gate_instance: gate_eval = evaluate(cached_models as ModelInfo, dev_mode=_router_dev_mode())"]
    SCOPEGATE --> SCOPEOUT["adds eligible_set=[m.id for m in gate_eval.eligible] and exclusions=[r.to_dict() for r in gate_eval.exclusions]"]

    SCOPE -- "model_id given" --> EXPLAIN["record = availability_cache_instance.explain(model_id)"]
    EXPLAIN --> KEY["CacheKey.for_candidate(model_id, policy_version)"]
    KEY --> ENTRY{"entry present?"}
    ENTRY -- "yes, age within ttl_seconds (60)" --> FRESH["cache_state=fresh, stale=False"]
    ENTRY -- "yes, ttl < age <= ttl + stale_window_seconds (30)" --> STALE["cache_state=stale, stale=True -- SWR window; get() also triggers _maybe_refresh, deduped by entry.refreshing"]
    ENTRY -- "yes, age beyond ttl + stale_window" --> EXPIRED["cache_state=expired, stale=True"]
    ENTRY -- "no entry" --> REFRESH["_refresh_locked(key, now) -> source() called synchronously"]
    REFRESH --> REFOK["source succeeds -> stored -> cache_state=fresh"]
    REFRESH --> REFERR["source raises -> _unknown_report(...); cache_state=error"]

    FRESH --> FREC["explain_freshness(report)"]
    STALE --> FREC
    EXPIRED --> FREC
    REFOK --> FREC
    REFERR --> FREC
    FREC --> FIELDS["record fields: source, policy_version, confidence, observed_at, expires_at, age_seconds, freshness_seconds, refreshing, refresh_error, errors, candidate_count, eligible_count, model_id, cache_state, stale"]

    FIELDS --> ELIG["if eligibility_gate_instance: gate_eval = evaluate([ModelInfo(model_id, provider, capability_tier=2)], dev_mode=_router_dev_mode())"]
    ELIG --> ELIGREC["record['eligibility'] = gate_eval.records[0].to_dict() when records present"]
    ELIGREC --> ELIGBOOL["record['eligible'] = gate_eval.records[0].admitted"]
    ELIGBOOL --> OUT200["JSONResponse(record) with kind=availability_explain"]

    CONF["_confidence_for(report): errors -> 0.0; source in {unknown, cache} and no candidates -> 0.0; source in {unknown, cache} -> scaled by eligible/candidates; else eligible/candidates ratio"]
    FREC --> CONF
