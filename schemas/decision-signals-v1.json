{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/mrnicholasbcarter-code/verdict-core/main/schemas/decision-signals-v1.json",
  "title": "DecisionSignalSetV1",
  "description": "Versioned decision signal set with strict validation (BOD-199)",
  "type": "object",
  "required": [
    "schema_version",
    "provider",
    "model",
    "version",
    "request_id",
    "purpose",
    "signals",
    "confidence",
    "latency_ms",
    "usage",
    "input_digest",
    "observed_at",
    "failure_class",
    "mode"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "decision-signals/v1"
    },
    "provider": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "request_id": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "signals": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "properties": {
            "complexity": {"type": "number", "minimum": 0, "maximum": 1},
            "decomposability": {"type": "number", "minimum": 0, "maximum": 1},
            "ambiguity": {"type": "number", "minimum": 0, "maximum": 1},
            "frontier_worthy": {"type": "number", "minimum": 0, "maximum": 1},
            "security_sensitive": {"type": "number", "minimum": 0, "maximum": 1},
            "verification_strength": {"type": "number", "minimum": 0, "maximum": 1},
            "context_need": {"type": "number", "minimum": 0, "maximum": 1}
          },
          "additionalProperties": false
        }
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "latency_ms": {
      "type": "integer",
      "minimum": 0
    },
    "usage": {
      "type": "object",
      "required": ["input_tokens", "output_tokens"],
      "additionalProperties": false,
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0}
      }
    },
    "input_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "failure_class": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "string",
          "enum": [
            "authentication",
            "authorization",
            "rate_limit",
            "quota",
            "invalid_request",
            "capability",
            "transport",
            "timeout",
            "upstream",
            "cancelled",
            "unknown",
            "overloaded"
          ]
        }
      ]
    },
    "mode": {
      "type": "string"
    }
  }
}
