{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verdict.dev/schemas/runtime-passport.v1.json",
  "title": "Verdict Runtime Negotiated Passport v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "subject", "qualified_at", "expires_at", "declared", "observed", "negotiated", "limitations"],
  "properties": {
    "schema_version": {"const": "1"},
    "subject": {"$ref": "#/$defs/subject"},
    "qualified_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "declared": {"$ref": "#/$defs/capability_map"},
    "observed": {"$ref": "#/$defs/capability_map"},
    "negotiated": {"$ref": "#/$defs/capability_map"},
    "limitations": {"$ref": "#/$defs/string_array"}
  },
  "$defs": {
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "subject_id", "provider", "protocol", "protocol_version", "transport", "auth_mode", "endpoint_digest"],
      "properties": {
        "kind": {"enum": ["tool", "mcp_server", "mcp_resource", "mcp_prompt", "a2a_peer", "acp_agent", "skill", "transport", "auth"]},
        "subject_id": {"$ref": "#/$defs/non_empty_string"},
        "provider": {"$ref": "#/$defs/non_empty_string"},
        "protocol": {"$ref": "#/$defs/non_empty_string"},
        "protocol_version": {"$ref": "#/$defs/non_empty_string"},
        "transport": {"$ref": "#/$defs/non_empty_string"},
        "auth_mode": {"$ref": "#/$defs/non_empty_string"},
        "endpoint_digest": {"$ref": "#/$defs/digest"},
        "scope": {"$ref": "#/$defs/non_empty_string"},
        "declared_schema_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "capability_map": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9_.-]*$"},
      "additionalProperties": {"$ref": "#/$defs/evidence"}
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "source", "observed_at", "expires_at", "confidence", "evidence_digest", "limitations", "authority", "method", "adapter_version", "scope"],
      "properties": {
        "status": {"enum": ["supported", "unsupported", "unknown"]},
        "source": {"$ref": "#/$defs/non_empty_string"},
        "observed_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence_digest": {"$ref": "#/$defs/digest"},
        "limitations": {"$ref": "#/$defs/string_array"},
        "authority": {"enum": ["claimed", "observed", "verified", "inferred"]},
        "method": {"$ref": "#/$defs/non_empty_string"},
        "adapter_version": {"$ref": "#/$defs/non_empty_string"},
        "scope": {"$ref": "#/$defs/non_empty_string"},
        "sample_count": {"type": "integer", "minimum": 1}
      }
    },
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "non_empty_string": {"type": "string", "minLength": 1},
    "string_array": {"type": "array", "items": {"$ref": "#/$defs/non_empty_string"}}
  }
}
