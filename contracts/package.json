{
  "name": "@bodanglin/verdict-contracts",
  "version": "0.1.0",
  "description": "Canonical Zod schemas and TypeScript types for Verdict v1 contracts",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "peerDependencies": {
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^10.8.0",
    "prettier": "^3.3.0",
    "typescript": "~5.6.0",
    "vitest": "^1.0.0",
    "zod": "^3.23.0"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrnicholasbcarter-code/verdict-core.git",
    "directory": "contracts"
  },
  "homepage": "https://github.com/mrnicholasbcarter-code/verdict-core/tree/main/contracts#readme",
  "bugs": {
    "url": "https://github.com/mrnicholasbcarter-code/verdict-core/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "verdict",
    "llm",
    "routing",
    "contracts",
    "zod",
    "typescript"
  ]
}
